# systemd --user unit: Gmail/Google Voice SMS ingest over IMAP IDLE.
# Put GMAIL_USER=... and GMAIL_APP_PASSWORD=... in ~/.config/dayfile/env (mode 600).
[Unit]
Description=dayfile email-in (IMAP IDLE)

[Service]
Environment=DAYFILE_DB=%h/.local/share/dayfile/dayfile.db
EnvironmentFile=%h/.config/dayfile/env
ExecStart=%h/.local/share/dayfile/venv/bin/dayfile poll-email --folder SMS
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
