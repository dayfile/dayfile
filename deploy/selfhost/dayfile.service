# systemd --user unit: the HTTP server. Install with deploy/selfhost/README.md.
# Expects dayfile in a virtualenv at ~/.local/share/dayfile/venv (the README creates it).
[Unit]
Description=dayfile HTTP server

[Service]
Environment=DAYFILE_DB=%h/.local/share/dayfile/dayfile.db
ExecStart=%h/.local/share/dayfile/venv/bin/uvicorn dayfile.app:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=default.target
