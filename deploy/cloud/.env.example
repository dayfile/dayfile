# Copy to .env (mode 600). Never commit .env.
DAYFILE_BASE_DOMAIN=dayfile.cloud         # tenants live at <slug>.dayfile.cloud
DAYFILE_AUTH_URI=https://dayfile.app/     # where unauthenticated clients are pointed; use /signup once it exists
DAYFILE_SITE_DOMAIN=dayfile.app           # the public site, served by the web app
DAYFILE_STATUS_MONITORS=            # optional: comma-separated UptimeRobot monitor names to show on /status (empty: all)
DAYFILE_STATUS_PAGE_URL=             # optional: the public UptimeRobot status page the /status page links to
ACCOUNTS_DIR=/srv/dayfile/accounts        # the web app's accounts.db (owned by uid 10001, mode 700)
SECRETS_DIR=/srv/dayfile/secrets          # holds github_client_secret (uid 10001, mode 400)
GITHUB_CLIENT_ID=                         # the OAuth app's client id (not secret); blank turns GitHub sign-in off
TENANTS_DIR=/srv/dayfile/tenants          # host path; must be owned by uid 10001 (the container user)

# Backups (backup-tenants.sh). An rclone remote, preferably a crypt remote layered on the bucket.
BACKUP_REMOTE=spaces:my-bucket/dayfile
BACKUP_PING_URL=

# Continuous replication (optional profile: docker compose --profile replicate up -d)
LITESTREAM_ENDPOINT=https://nyc3.digitaloceanspaces.com
LITESTREAM_BUCKET=my-bucket
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
